How do you find employees who earn more than the average salary in their department? 
------------------------------------------------------------------------------------------

SELECT * --Correlated subquery
FROM employees e
WHERE salary > (
    SELECT AVG(salary)
    FROM employees e1
    WHERE e1.department = e.department
);


WITH cte AS (

    SELECT *,

           AVG(salary) OVER (PARTITION BY dept) AS dept_avg

    FROM emp

)

SELECT *

FROM cte

WHERE salary > dept_avg;
