Find employees with the highest salary in each department. 

SELECT *  --Correlated subquery
FROM employees e1
WHERE salary = (
    SELECT MAX(salary)
    FROM employees e2
    WHERE e2.department = e1.department
);



WITH cte AS (   --Window function with CTE
    SELECT *,
           RANK() OVER (
               PARTITION BY department
               ORDER BY salary DESC
           ) AS rnk
    FROM employees
)
SELECT *
FROM cte
WHERE rnk = 1;


WITH cte AS ( --Returns One Employee Per Department
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY department
               ORDER BY salary DESC
           ) AS rn
    FROM employees
)
SELECT *
FROM cte
WHERE rn = 1;
