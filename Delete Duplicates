Write SQL query to delete duplicates. 

WITH cte AS (
    SELECT id,
           ROW_NUMBER() OVER (
               PARTITION BY name, department
               ORDER BY id
           ) AS rn
    FROM employees
)
DELETE FROM employees
WHERE id IN (
    SELECT id
    FROM cte
    WHERE rn > 1
);

DELETE e1  --Self join
FROM employees e1
JOIN employees e2
    ON e1.name = e2.name
   AND e1.department = e2.department
   AND e1.id > e2.id;
