Delete e1 --using self join
from employee e1 
join employee e2 
on e1.name=e2.name and e1.salary=e2.salary 
and e1.id>e2.id


WITH cte AS ( --Postgresql with cte 
    SELECT id,
           ROW_NUMBER() OVER (
               PARTITION BY name, salary
               ORDER BY id
           ) AS rn
    FROM employee
)
DELETE FROM employee
WHERE id IN (
    SELECT id
    FROM cte
    WHERE rn > 1
);

