# Delete Duplicates
---------------------------------------------------------------------------------

emp
+--------+-------+---------------------+
| id     | name  | last_login          |
+--------+-------+---------------------+
| 1      | John  | 2024-01-01 10:00:00 |
| 2      | John  | 2024-01-05 12:00:00 |
| 3      | Alice | 2024-01-02 09:00:00 |
| 4      | Alice | 2024-01-07 08:00:00 |
+--------+-------+---------------------+


Delete e1 --using self join
from employee e1 
join employee e2 
on e1.name=e2.name and e1.salary=e2.salary 
and e1.id>e2.id


WITH cte AS ( --Postgresql with cte 
    SELECT id,
           ROW_NUMBER() OVER (
               PARTITION BY name, salary
               ORDER BY id
           ) AS rn
    FROM employee
)
DELETE FROM employee
WHERE id IN (
    SELECT id
    FROM cte
    WHERE rn > 1
);



WITH cte AS ( --same login
    SELECT *,
           ROW_NUMBER() OVER(
               PARTITION BY name
               ORDER BY last_login DESC, id DESC
           ) rn
    FROM emp
)
DELETE FROM emp
WHERE id IN (
    SELECT id
    FROM cte
    WHERE rn > 1
);

