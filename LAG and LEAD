SELECT emp_id,--Salary Greater Than Previous Employee
       salary,
       LAG(salary) OVER (ORDER BY emp_id) prev_salary
FROM employees;


WITH cte AS (  --CTE with Window functions
    SELECT emp_id,
           salary,
           LAG(salary) OVER (ORDER BY emp_id) prev_salary
    FROM employees
)
SELECT *
FROM cte
WHERE salary > prev_salary;

SELECT product_id, --Current Row with Next Row
       price,
       LEAD(price) OVER (ORDER BY product_id) next_price
FROM products;
